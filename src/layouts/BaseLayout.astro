---
import '@fontsource-variable/inter';
import '@fontsource/noto-sans-ethiopic/400.css';
import '@fontsource/noto-sans-ethiopic/700.css';
import '../styles/global.css';
import { LOCALES, LOCALE_META, t, type Locale } from '../i18n/index';
import { assetPath, localizedPath, samePath, switchLocalePath } from '../i18n/paths';
import { NAV } from '../i18n/nav';
import CrossMotif from '../components/CrossMotif.astro';
import TodayDate from '../components/TodayDate.astro';

interface Props {
  lang: Locale;
  title: string;
  description?: string;
  /** False on pages with no per-locale counterpart (the 404). */
  showLangToggle?: boolean;
}

const { lang, title, description, showLangToggle = true } = Astro.props;
const other = LOCALES.find((l) => l !== lang)!;
const siteName = t(lang, 'site.name');
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang={LOCALE_META[lang].htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{`${title} — ${siteName}`}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/svg+xml" href={assetPath('favicon.svg')} />
  </head>
  <body>
    <a class="skip-link" href="#main">{t(lang, 'a11y.skipToContent')}</a>
    <header class="site-header">
      <a class="site-name" href={localizedPath(lang, '')}>
        <CrossMotif size={28} />
        {siteName}
      </a>
      <nav class="site-nav" aria-label={t(lang, 'a11y.mainNav')}>
        <ul>
          {
            NAV.map((item) => {
              const href = localizedPath(lang, item.slug);
              return (
                <li>
                  <a href={href} aria-current={samePath(href, currentPath) ? 'page' : undefined}>
                    {t(lang, item.key)}
                  </a>
                </li>
              );
            })
          }
        </ul>
      </nav>
      {
        showLangToggle && (
          <a
            class="lang-toggle"
            href={switchLocalePath(currentPath, other)}
            hreflang={LOCALE_META[other].htmlLang}
          >
            <span class="visually-hidden">{t(lang, 'a11y.langToggle')}: </span>
            <span lang={LOCALE_META[other].htmlLang}>{t(lang, 'lang.switchTo')}</span>
          </a>
        )
      }
    </header>
    <div class="today-strip">
      <TodayDate lang={lang} />
    </div>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <p>{t(lang, 'footer.rights')}</p>
    </footer>
  </body>
</html>
