---
// Decorative architectural band inspired by Aksumite church building: a
// gold beam resting on a row of columns with stepped capitals and bases,
// with the square protruding beam-ends ("monkey heads") of Aksumite
// timber-and-stone walls between them. Original geometry, not traced from
// any existing artwork. Purely decorative: hidden from assistive tech.
interface Props {
  height?: number;
}

const { height = 30 } = Astro.props;

// One 48x30 tile, repeated horizontally.
const TILE_W = 48;
const TILE_H = 30;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  class="aksum-frieze"
  width="100%"
  height={height}
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <pattern id="aksum-tile" patternUnits="userSpaceOnUse" width={TILE_W} height={TILE_H}>
      <!-- wall behind the columns -->
      <rect x="0" y="0" width={TILE_W} height={TILE_H} fill="var(--color-green-dark)" />
      <!-- beam -->
      <rect x="0" y="0" width={TILE_W} height="5" fill="var(--color-gold)" />
      <rect x="0" y="5" width={TILE_W} height="1.5" fill="var(--color-gold-dark)" />
      <!-- monkey-head beam ends on the tile seam (split so the pattern tiles seamlessly) -->
      <rect x="-2.5" y="10" width="5" height="5" fill="var(--color-gold)" />
      <rect x="45.5" y="10" width="5" height="5" fill="var(--color-gold)" />
      <!-- column: stepped capital, shaft, stepped base -->
      <rect x="14" y="6.5" width="20" height="4" fill="var(--color-gold)" />
      <rect x="17" y="10.5" width="14" height="4" fill="var(--color-gold)" />
      <rect x="20" y="14.5" width="8" height="11.5" fill="var(--color-gold)" />
      <rect x="17" y="26" width="14" height="2" fill="var(--color-gold)" />
      <rect x="14" y="28" width="20" height="2" fill="var(--color-gold)" />
    </pattern>
  </defs>
  <rect x="0" y="0" width="100%" height="100%" fill="url(#aksum-tile)" />
</svg>
