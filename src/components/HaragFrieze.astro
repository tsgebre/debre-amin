---
// Harag (ሐረግ) band: the interlaced vine-and-tendril ornament that frames
// text columns and marks chapter openings in Ethiopian Orthodox manuscripts.
// Drawn as manuscript decoration: a parchment strip ruled top and bottom,
// an undulating vine stem with alternating leaves, tendril curls at the
// nodes, and small grape clusters — original geometry, not traced from any
// existing artwork. Purely decorative: hidden from assistive tech.
interface Props {
  height?: number;
}

const { height = 30 } = Astro.props;

// One 80x30 tile, repeated horizontally. The stem's slope matches at x=0
// and x=80, and seam elements are drawn on both edges, so the tile joins
// seamlessly.
const TILE_W = 80;
const TILE_H = 30;

// A lens-shaped vine leaf: grows from (x, y) to a tip `len` away, curving
// `bow` to each side. Negative len points the leaf upward.
function leaf(x: number, y: number, len: number, bow: number): string {
  const tip = y + len;
  const mid = y + len / 2;
  return `M ${x} ${y} Q ${x + bow} ${mid} ${x} ${tip} Q ${x - bow} ${mid} ${x} ${y} Z`;
}

// A grape cluster: three berries in a triangle, hanging from (x, y).
function grapes(x: number, y: number, dir: 1 | -1): Array<[number, number]> {
  return [
    [x, y + 2 * dir],
    [x - 3, y + 5.5 * dir],
    [x + 3, y + 5.5 * dir],
  ];
}

const BERRY_R = 1.9;
const crest = grapes(30, 14, 1); // below the stem, after the first crest
const trough = grapes(70, 16, -1); // above the stem, after the trough
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  class="harag-frieze"
  width="100%"
  height={height}
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <pattern id="harag-tile" patternUnits="userSpaceOnUse" width={TILE_W} height={TILE_H}>
      <!-- parchment strip -->
      <rect x="0" y="0" width={TILE_W} height={TILE_H} fill="var(--color-cream)" />
      <!-- double manuscript rules: brown outer, red inner -->
      <rect x="0" y="0" width={TILE_W} height="2" fill="var(--color-brown)" />
      <rect x="0" y="3" width={TILE_W} height="0.75" fill="var(--color-red)" />
      <rect x="0" y="26.25" width={TILE_W} height="0.75" fill="var(--color-red)" />
      <rect x="0" y="28" width={TILE_W} height="2" fill="var(--color-brown)" />
      <!-- vine stem -->
      <path
        d="M 0 15 C 13 4, 27 4, 40 15 C 53 26, 67 26, 80 15"
        fill="none"
        stroke="var(--color-brown)"
        stroke-width="1.8"
      />
      <!-- lens leaves growing into the wave hollows: down from the crest,
           up from the trough -->
      <path d={leaf(20, 6.75, 6.5, 3.5)} fill="var(--color-red)" />
      <path d={leaf(60, 23.25, -6.5, 3.5)} fill="var(--color-red)" />
      <!-- tendril curls at the stem nodes (drawn on both edges for the seam) -->
      <circle cx="0" cy="15" r="2" fill="none" stroke="var(--color-red)" stroke-width="1.2" />
      <circle cx="80" cy="15" r="2" fill="none" stroke="var(--color-red)" stroke-width="1.2" />
      <circle cx="40" cy="15" r="2" fill="none" stroke="var(--color-red)" stroke-width="1.2" />
      <!-- grape clusters -->
      {crest.map(([cx, cy]) => <circle cx={cx} cy={cy} r={BERRY_R} fill="var(--color-gold-dark)" />)}
      {trough.map(([cx, cy]) => <circle cx={cx} cy={cy} r={BERRY_R} fill="var(--color-gold-dark)" />)}
    </pattern>
  </defs>
  <rect x="0" y="0" width="100%" height="100%" fill="url(#harag-tile)" />
</svg>
