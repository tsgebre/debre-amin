---
import BaseLayout from '../layouts/BaseLayout.astro';
import AboutSection from './AboutSection.astro';
import ParishHistory from './ParishHistory.astro';
import { t, type Locale } from '../i18n/index';
import type { Bilingual } from '../data/site';
import type { AboutEntry } from '../content/schemas';
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';

export interface AboutViewSection {
  title: string;
  sources: AboutEntry['sources'];
  amReviewPending: boolean;
  image?: AboutEntry['image'];
  // A rendered collection entry's <Content /> component.
  Content: AstroComponentFactory;
}

interface Props {
  lang: Locale;
  history: Bilingual;
  sections: AboutViewSection[];
}

const { lang, history, sections } = Astro.props;
---

<BaseLayout lang={lang} title={t(lang, 'nav.about')} description={t(lang, 'meta.about.description')}>
  <h1>{t(lang, 'nav.about')}</h1>
  <ParishHistory lang={lang} history={history} />
  {
    sections.map(({ title, sources, amReviewPending, image, Content }) => (
      <AboutSection
        lang={lang}
        title={title}
        sources={sources}
        amReviewPending={amReviewPending}
        image={image}
      >
        <Content />
      </AboutSection>
    ))
  }
</BaseLayout>
