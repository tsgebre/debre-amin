---
import MixedText from './MixedText.astro';
import { t, type Locale } from '../i18n/index';
import { assetPath } from '../i18n/paths';
import type { AboutEntry } from '../content/schemas';

interface Props {
  lang: Locale;
  title: string;
  sources: AboutEntry['sources'];
  amReviewPending: boolean;
  image?: AboutEntry['image'];
}

const { lang, title, sources, amReviewPending, image } = Astro.props;
const showReviewNote = lang === 'am' && amReviewPending;

// Source titles keep their original language (currently all English). Mark
// each link whose script differs from the page language.
const ETHIOPIC = /[\u1200-\u137F]/;
const sourceLang = (title: string): Locale => (ETHIOPIC.test(title) ? 'am' : 'en');
---

<section class="about-section">
  <h2>{title}</h2>
  {
    image && (
      <figure class="about-figure">
        <img
          src={assetPath(image.src)}
          alt={image.alt}
          width={image.width}
          height={image.height}
          loading="lazy"
          decoding="async"
        />
        <figcaption>
          {image.caption && (
            <span class="about-figure-caption">
              <MixedText lang={lang} text={image.caption} />
            </span>
          )}
          {image.credit && (
            <span class="image-credit">
              {image.creditUrl ? (
                <a href={image.creditUrl}>
                  <MixedText lang={lang} text={image.credit} />
                </a>
              ) : (
                <MixedText lang={lang} text={image.credit} />
              )}
            </span>
          )}
        </figcaption>
      </figure>
    )
  }
  <slot />
  {showReviewNote && <p class="review-note">{t(lang, 'about.amReviewNote')}</p>}
  <details class="sources">
    <summary>{t(lang, 'about.sources')}</summary>
    <ul>
      {
        sources.map((s) => (
          <li>
            <a href={s.url} lang={sourceLang(s.title) === lang ? undefined : sourceLang(s.title)}>
              {s.title}
            </a>
          </li>
        ))
      }
    </ul>
  </details>
</section>
