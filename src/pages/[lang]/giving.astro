---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GivingDetails from '../../components/GivingDetails.astro';
import { LOCALES, t, type Locale } from '../../i18n/index';
import { siteConfig } from '../../data/site';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
---

<BaseLayout lang={lang} title={t(lang, 'nav.giving')} description={t(lang, 'giving.intro')}>
  <h1>{t(lang, 'nav.giving')}</h1>
  <p>{t(lang, 'giving.intro')}</p>

  <GivingDetails lang={lang} giving={siteConfig.giving} />

  <section>
    <h2>{t(lang, 'giving.notes.heading')}</h2>
    <p>{t(lang, 'giving.notes.noPayment')}</p>
    <p>{t(lang, 'giving.notes.confirm')}</p>
  </section>
</BaseLayout>
