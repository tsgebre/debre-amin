---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactDetails from '../../components/ContactDetails.astro';
import { LOCALES, t, type Locale } from '../../i18n/index';
import { siteConfig } from '../../data/site';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
---

<BaseLayout lang={lang} title={t(lang, 'nav.contact')} description={t(lang, 'meta.contact.description')}>
  <h1>{t(lang, 'nav.contact')}</h1>
  <p>{t(lang, 'contact.intro')}</p>
  <ContactDetails lang={lang} contact={siteConfig.contact} />
</BaseLayout>
