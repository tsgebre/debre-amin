---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Fact from '../../components/Fact.astro';
import { LOCALES, t, type Locale } from '../../i18n/index';
import { siteConfig } from '../../data/site';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
---

<BaseLayout lang={lang} title={t(lang, 'nav.services')} description={t(lang, 'services.intro')}>
  <h1>{t(lang, 'nav.services')}</h1>
  <p>{t(lang, 'services.intro')}</p>

  <div
    class="table-scroll"
    role="region"
    aria-label={t(lang, 'services.table.scrollLabel')}
    tabindex="0"
  >
    <table>
      <caption>{t(lang, 'services.table.caption')}</caption>
      <thead>
        <tr>
          <th scope="col">{t(lang, 'services.table.service')}</th>
          <th scope="col">{t(lang, 'services.table.day')}</th>
          <th scope="col">{t(lang, 'services.table.time')}</th>
        </tr>
      </thead>
      <tbody>
        {
          siteConfig.services.map((service, i) => (
            <tr>
              <td>{service.name[lang]}</td>
              <td>
                <Fact lang={lang} value={service.day[lang]} field={`services.${i}.day.${lang}`} />
              </td>
              <td>
                <Fact lang={lang} value={service.time} field={`services.${i}.time`} />
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <section>
    <h2>{t(lang, 'services.liturgy.heading')}</h2>
    <p>{t(lang, 'services.liturgy.body')}</p>
  </section>

  <section>
    <h2>{t(lang, 'services.sundaySchool.heading')}</h2>
    <p>{t(lang, 'services.sundaySchool.body')}</p>
  </section>

  <section>
    <h2>{t(lang, 'services.prayerTeaching.heading')}</h2>
    <p>{t(lang, 'services.prayerTeaching.body')}</p>
  </section>

  <p>
    {t(lang, 'services.livestream.label')}:{' '}
    <Fact lang={lang} value={siteConfig.livestreamUrl} field="livestreamUrl" as="link" />
  </p>
</BaseLayout>
