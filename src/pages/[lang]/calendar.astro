---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CalendarView from '../../components/CalendarView.astro';
import { LOCALES, t, type Locale } from '../../i18n/index';
import { ethiopianTodayIn } from '../../lib/ecal';
import { siteConfig } from '../../data/site';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const timeZone = siteConfig.timeZone;
const ey = ethiopianTodayIn(timeZone).year;
---

<BaseLayout lang={lang} title={t(lang, 'nav.calendar')} description={t(lang, 'meta.calendar.description')}>
  <CalendarView lang={lang} years={[ey, ey + 1]} timeZone={timeZone} />
</BaseLayout>
