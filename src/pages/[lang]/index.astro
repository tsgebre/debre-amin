---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import HomeView from '../../components/HomeView.astro';
import { LOCALES, t, type Locale } from '../../i18n/index';
import { ethiopianTodayIn, toGregorian } from '../../lib/ecal';
import { siteConfig } from '../../data/site';
import { publishable, sortNewestFirst, toAnnouncementItems, type EventItem } from '../../lib/events';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const today = toGregorian(ethiopianTodayIn(siteConfig.timeZone));

const entries = await getCollection('events');
const items: EventItem[] = entries.map((e) => ({ slug: e.id, data: e.data }));
const announcements = toAnnouncementItems(
  sortNewestFirst(publishable(items)),
  lang,
  import.meta.env.BASE_URL,
);
---

<BaseLayout lang={lang} title={t(lang, 'nav.home')} description={t(lang, 'site.tagline')}>
  <HomeView lang={lang} today={today} announcements={announcements} />
</BaseLayout>
