---
import { resolve } from 'node:path';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import GalleryGrid from '../../components/GalleryGrid.astro';
import { LOCALES, t, type Locale } from '../../i18n/index';
import { missingImages, sortGallery, type GalleryItem } from '../../lib/gallery';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;

const entries = await getCollection('gallery');
const items: GalleryItem[] = entries.map((e) => ({ slug: e.id, data: e.data }));

// `astro build`/`astro dev`/`astro check` always run with the project root
// as the working directory.
const missing = missingImages(items, resolve(process.cwd(), 'public'));
if (missing.length > 0) {
  // Astro's frontmatter parser mishandles a template literal nested inside
  // another template literal's ${...} here — keep this as two statements.
  const names = missing.map((m) => `"${m.slug}.yaml" -> public/${m.data.image}`).join(', ');
  throw new Error(`Gallery: missing image file(s) for ${names}. Add the file, or fix the path in that YAML entry.`);
}

const list = sortGallery(items);
---

<BaseLayout lang={lang} title={t(lang, 'nav.gallery')} description={t(lang, 'gallery.intro')}>
  <h1>{t(lang, 'nav.gallery')}</h1>
  <p>{t(lang, 'gallery.intro')}</p>
  <GalleryGrid lang={lang} items={list} />
</BaseLayout>
